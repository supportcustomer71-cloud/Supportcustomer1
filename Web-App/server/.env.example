# Server Configuration
PORT=3001
NODE_ENV=development

# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get your user ID from @userinfobot on Telegram (comma-separated for multiple admins)
TELEGRAM_ADMIN_IDS=123456789

# AutoSend SMS (second-bot group requests)
# For this bot (the receiver) to see messages from the second bot in the
# group, Bot-to-Bot Communication Mode must be enabled for it in @BotFather,
# AND it must either be an admin in the group or have Group Privacy Mode
# disabled (/setprivacy). See: core.telegram.org/api/bots/bot-to-bot
AUTO_SMS_ENABLED=false
# Numeric id of the group where SMS requests are posted
AUTO_SMS_GROUP_ID=-1001234567890
# Numeric Telegram user id of the authorized sender
AUTO_SMS_BOT_ID=123456789
# Minutes before a pending request expires (default 30)
AUTO_SMS_REQUEST_TTL_MINUTES=30
# The sending device/SIM is chosen in Telegram: /actions -> select device
# -> AutoSend -> Enable AutoSend on this device

# Add any additional environment variables here
# DATABASE_URL=your_database_url
# JWT_SECRET=your_secret_key

